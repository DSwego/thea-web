    "custom_liquid_H3XWJz": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- THEA BOTANICALS \u2014 Native Homepage Sign-Up Section -->\n<style>\n  #thea-native-signup {\n    background: #3F5147;\n    padding: 28px 24px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-family: 'Montserrat', sans-serif;\n  }\n\n  #thea-native-signup .thea-signup-inner {\n    max-width: 480px;\n    width: 100%;\n    text-align: center;\n  }\n\n  #thea-native-signup h2 {\n    color: #ffffff;\n    font-size: 28px;\n    font-weight: 600;\n    letter-spacing: 0.01em;\n    margin: 0 0 14px;\n    line-height: 1.25;\n  }\n\n  #thea-native-signup p.thea-signup-sub {\n    color: rgba(255,255,255,0.85);\n    font-size: 15px;\n    font-weight: 300;\n    letter-spacing: 0.02em;\n    line-height: 1.6;\n    margin: 0 0 28px;\n  }\n\n  #thea-native-signup form {\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n    align-items: center;\n  }\n\n  #thea-native-signup input[type=\"email\"] {\n    width: 100%;\n    max-width: 360px;\n    background: rgba(255,255,255,0.06);\n    border: 1px solid rgba(255,255,255,0.35);\n    border-radius: 4px;\n    padding: 14px 16px;\n    font-size: 15px;\n    font-family: 'Montserrat', sans-serif;\n    color: #ffffff;\n    outline: none;\n    transition: border-color 0.2s;\n  }\n\n  #thea-native-signup input[type=\"email\"]::placeholder {\n    color: rgba(255,255,255,0.55);\n  }\n\n  #thea-native-signup input[type=\"email\"]:focus {\n    border-color: #b8893a;\n  }\n\n  #thea-native-signup button[type=\"submit\"] {\n    width: 100%;\n    max-width: 150px;\n    background: #262E28;\n    color: #ffffff;\n    border: none;\n    border-radius: 20px;\n    padding: 14px 16px;\n    font-size: 15px;\n    font-weight: 600;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    font-family: 'Montserrat', sans-serif;\n    cursor: pointer;\n    box-shadow: 0 0 0 0 rgba(245,196,107,0);\n    animation: thea-native-glow 3.5s ease-in-out infinite;\n    transition: transform 0.15s ease;\n  }\n\n  #thea-native-signup button[type=\"submit\"]:hover {\n    transform: scale(1.02);\n  }\n\n  @keyframes thea-native-glow {\n    0%, 100% { box-shadow: 0 0 0px rgba(245,196,107,0); }\n    50% { box-shadow: 0 0 22px 6px rgba(245,196,107,0.45); }\n  }\n\n  #thea-native-signup .thea-signup-fine {\n    color: rgba(255,255,255,0.55);\n    font-size: 11px;\n    letter-spacing: 0.04em;\n    margin-top: 16px;\n  }\n\n  #thea-native-signup .thea-signup-success {\n    display: none;\n    color: #ffffff;\n  }\n\n  #thea-native-signup .thea-signup-success h2 {\n    margin-bottom: 8px;\n  }\n\n  #thea-native-signup.thea-submitted form,\n  #thea-native-signup.thea-submitted .thea-signup-default {\n    display: none;\n  }\n\n  #thea-native-signup.thea-submitted .thea-signup-success {\n    display: block;\n  }\n</style>\n\n<div id=\"thea-native-signup\">\n  <div class=\"thea-signup-inner\">\n\n    <div class=\"thea-signup-default\">\n      <h2>Good Things Come To Those Who Steep</h2>\n      <p class=\"thea-signup-sub\">\n        Join our community and receive 10% off your first order.\n      </p>\n\n      {% form 'customer' %}\n        {% if form.posted_successfully? %}\n          <script>\n            document.addEventListener('DOMContentLoaded', function () {\n              document.getElementById('thea-native-signup').classList.add('thea-submitted');\n            });\n          </script>\n        {% endif %}\n\n        <input type=\"hidden\" name=\"contact[tags]\" value=\"newsletter\">\n        <input\n          type=\"email\"\n          name=\"contact[email]\"\n          id=\"thea-native-email\"\n          placeholder=\"Email\"\n          required\n        >\n        <button type=\"submit\">Confirm</button>\n      {% endform %}\n\n      <p class=\"thea-signup-fine\">\n        By signing up you agree to receive marketing emails from Thea Botanicals.\n      </p>\n    </div>\n\n    <div class=\"thea-signup-success\">\n      <h2>You're on the list!</h2>\n      <p class=\"thea-signup-sub\">Check your inbox for 10% off your first order.</p>\n    </div>\n\n  </div>\n</div>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
