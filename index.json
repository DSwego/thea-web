    "custom_liquid_subscribe": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.thea-sub{position:relative;overflow:hidden;isolation:isolate;color:#fff;text-align:center;background:#26302a;font-family:var(--font-body-family);padding:76px 24px 80px;}\n.thea-sub__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;z-index:-2;}\n.thea-sub:before{content:\"\";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(24,32,27,.88) 0%,rgba(38,48,41,.80) 45%,rgba(24,32,27,.92) 100%);}\n.thea-sub__in{max-width:1040px;margin:0 auto;}\n.thea-sub__eyebrow{display:inline-block;font-size:1.15rem;letter-spacing:.32em;text-transform:uppercase;color:#d9b97a;margin:0 0 18px;padding:0 0 12px;border-bottom:1px solid rgba(217,185,122,.55);}\n.thea-sub h2{font-family:var(--font-heading-family);font-weight:400;font-size:4rem;line-height:1.15;letter-spacing:.01em;margin:0 0 16px;color:#fff;}\n.thea-sub__lead{font-size:1.55rem;line-height:1.7;max-width:620px;margin:0 auto 38px;color:rgba(255,255,255,.88);font-weight:300;}\n.thea-sub__perks{list-style:none;margin:0 auto 44px;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:0;max-width:960px;}\n.thea-sub__perks li{padding:6px 18px;font-size:1.3rem;line-height:1.55;color:rgba(255,255,255,.85);font-weight:300;}\n.thea-sub__perks li+li{border-left:1px solid rgba(255,255,255,.22);}\n.thea-sub__perks strong{display:block;font-family:var(--font-heading-family);font-weight:400;font-size:1.7rem;color:#fff;margin-bottom:4px;}\n.thea-sub__plans{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:0 auto 34px;}\n.thea-sub__plan{display:block;background:rgba(255,255,255,.07);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.3);border-radius:4px;padding:28px 16px 26px;color:#fff;text-decoration:none;transition:background .25s,border-color .25s,transform .25s;}\n.thea-sub__plan:hover{background:rgba(255,255,255,.15);border-color:#d9b97a;transform:translateY(-3px);}\n.