    background-repeat: repeat;
  }

  #thea-messages::-webkit-scrollbar { width: 2px; }
  #thea-messages::-webkit-scrollbar-track { background: transparent; }
  #thea-messages::-webkit-scrollbar-thumb { background: #6a6a6a; border-radius: 1px; }

  .thea-msg {
    display: flex;
    flex-direction: column;
    animation: thea-msg-in 0.3s ease both;
  }

  @keyframes thea-msg-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .thea-msg.thea-agent { align-items: flex-start; }
  .thea-msg.thea-user { align-items: flex-end; }

  .thea-msg-label {
    font-size: 8px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 4px;
    font-weight: 600;
  }

  .thea-agent .thea-msg-label { color: #c9a876; }
  .thea-user .thea-msg-label { color: #b8b8b8; }

  .thea-bubble {
    max-width: 87%;
    padding: 12px 15px;
    font-size: 13px;
    line-height: 1.75;
    border-radius: 2px;
    font-weight: 450;
    letter-spacing: 0.01em;
  }

  .thea-agent .thea-bubble {
    background: #3d4a32;
    border: none;
    color: #ffffff;
    border-radius: 12px 12px 12px 2px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.18), 0 2px 8px rgba(0,0,0,0.12);
  }

  .thea-user .thea-bubble {
    background: #2b2b2b;
    border: none;
    color: #ffffff;
    font-size: 12.5px;
    font-weight: 500;
    border-radius: 12px 12px 2px 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.25);
  }

  /* Typing */
  #thea-typing {
    display: none;
    flex-direction: column;
    padding: 0 16px 8px;
    animation: thea-msg-in 0.3s ease both;
  }

  #thea-typing.thea-visible { display: flex; }

  #thea-typing-label {
    font-size: 8px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 4px;
    font-weight: 600;
    color: #c9a876;
  }

  #thea-typing-dots {
    background: #3d4a32;
    border: none;
    padding: 12px 15px;
    border-radius: 2px;
    display: inline-flex;
    gap: 5px;
    align-items: center;
    box-shadow: 0 4px 16px rgba(0,0,0,0.18), 0 2px 8px rgba(0,0,0,0.12);
  }

  .thea-dot {
    width: 5px;
    height: 5px;
    background: #ffffff;
    border-radius: 50%;
    opacity: 0.5;
    animation: thea-dot-bounce 1.4s infinite;
  }

  .thea-dot:nth-child(2) { animation-delay: 0.2s; }
  .thea-dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes thea-dot-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.35; }
    30% { transform: translateY(-5px); opacity: 1; }
  }

  /* Divider */
  .thea-divider {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 2px 0 6px;
  }

  .thea-divider span {
    font-size: 8px;
    letter-spacing: 0.2em;
    color: rgba(255,255,255,0.55);
    text-transform: uppercase;
    white-space: nowrap;
    font-weight: 500;
  }

  .thea-divider::before,
  .thea-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255,255,255,0.22);
  }

  /* Input */
  #thea-input-area {
    padding: 12px 14px;
    border-top: 1px solid rgba(184,137,58,0.08);
    background: #0f1109;
    display: flex;
    gap: 10px;
    align-items: flex-end;
    flex-shrink: 0;
  }

  #thea-input {
    flex: 1;
    background: #131510;
    border: 1px solid rgba(184,137,58,0.12);
    border-radius: 2px;
    color: #ddd8cf;
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    font-weight: 300;
    padding: 10px 14px;
    resize: none;
    outline: none;
    line-height: 1.5;
    max-height: 88px;
    overflow-y: auto;
    transition: border-color 0.2s;
    letter-spacing: 0.02em;
  }

  #thea-input::placeholder { color: #3a4535; }
  #thea-input:focus { border-color: rgba(184,137,58,0.4); }

  #thea-send {
    width: 40px;
    height: 40px;
    background: #3d4a32;
    border: none;
    border-radius: 2px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.1s;
    flex-shrink: 0;
  }

  #thea-send:hover { background: #4d5e40; }
  #thea-send:active { transform: scale(0.93); }
  #thea-send:disabled { opacity: 0.4; cursor: not-allowed; }
  #thea-send svg { fill: #b8893a; width: 15px; height: 15px; }

  /* Footer */
  #thea-footer {
    text-align: center;
    padding: 7px;
    font-size: 8px;
    letter-spacing: 0.14em;
    color: #1e2619;
    text-transform: uppercase;
    background: #0f1109;
    font-weight: 500;
  }

  /* Mobile */
  @media (max-width: 480px) {
    #thea-backdrop {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      background: #131510;
      z-index: 99998;
    }

    #thea-backdrop.thea-open {
      display: block;
    }

    #thea-window {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 100%;
      height: 100dvh;
      max-height: 100dvh;
      border-radius: 0;
      border: none;
      z-index: 99999;
      transform: none !important;
    }

    #thea-window.thea-open {
      transform: none !important;
    }

    #thea-trigger-wrap {
      bottom: 20px;
      right: 16px;
    }

    #thea-trigger-label {
      font-size: 11px;
      padding: 8px 14px;
      letter-spacing: 0.1em;
    }

    #thea-trigger {
      width: 56px;
