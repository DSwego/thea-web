</style>

<div id="thea-widget">
  <!-- Trigger: Ask Thea label + circular logo button -->
  <div id="thea-trigger-wrap" onclick="theaToggle()" role="button" aria-label="Chat with Thea">
    <span id="thea-trigger-label">Ask Thea</span>
    <button id="thea-trigger" aria-label="Chat with Thea" tabindex="-1">
      <img src="https://cdn.shopify.com/s/files/1/1001/3619/0287/files/THEA_Logo_for_chat_bot_widget.png?v=1781129301" alt="Thea">
    </button>
  </div>

  <!-- Full-screen backdrop (mobile) — covers website completely -->
  <div id="thea-backdrop"></div>

  <!-- Chat Window -->
  <div id="thea-window" role="dialog" aria-label="Chat with Thea Botanicals">

    <!-- Header — logo centred, no text title -->
    <div id="thea-header">
      <div id="thea-header-controls">
        <button id="thea-close" onclick="theaToggle()" aria-label="Close">✕</button>
      </div>
      <img id="thea-header-logo"
        src="https://cdn.shopify.com/s/files/1/1001/3619/0287/files/All_White_New_Logo.png?v=1781127496"
        alt="Thea Botanicals">
      <p id="thea-header-tagline">I'm here whenever you're ready.</p>
    </div>

    <div id="thea-messages">
      <div class="thea-divider"><span>Begin</span></div>
    </div>

    <div id="thea-typing">
      <div id="thea-typing-label">Thea</div>
      <div id="thea-typing-dots">
        <div class="thea-dot"></div>
        <div class="thea-dot"></div>
        <div class="thea-dot"></div>
      </div>
    </div>

    <div id="thea-input-area">
      <textarea id="thea-input" rows="1" placeholder="Speak to Thea…"
        onkeydown="theaHandleKey(event)"
        oninput="theaResize(this)"></textarea>
      <button id="thea-send" onclick="theaSend()" aria-label="Send">
        <svg viewBox="0 0 24 24"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg>
      </button>
    </div>

    <div id="thea-footer">Thea Botanicals · Powered by AI</div>
  </div>
</div>

<script>
  const THEA_API = "https://thea-web.onrender.com/chat";
  let theaHistory = [];
  let theaIsOpen = false;
  let theaStarted = false;
  let theaScrollY = 0;

  // Wake up Render server as soon as page loads — silent background ping
  // This means by the time customer opens the widget, server is already awake
  window.addEventListener('load', function() {
    fetch(THEA_API.replace('/chat', '/ping'), { method: 'GET' }).catch(() => {});
  });

  // Fix iOS keyboard pushing content — use visualViewport API
  if (window.visualViewport) {
    window.visualViewport.addEventListener('resize', function() {
      const win = document.getElementById('thea-window');
      if (win && win.classList.contains('thea-open') && window.innerWidth <= 480) {
        win.style.height = window.visualViewport.height + 'px';
        win.style.top = window.visualViewport.offsetTop + 'px';
        win.style.bottom = 'auto';
      }
    });
  }

  function theaToggle() {
    const wrap = document.getElementById('thea-trigger-wrap');

    // Opening: play the merge/glow sequence first, then reveal chat
    if (!theaIsOpen) {
      if (wrap) {
        wrap.classList.add('thea-merging');
        setTimeout(() => wrap.classList.add('thea-merging-out'), 560);
      }
      setTimeout(() => theaOpenChat(), 420);
      return;
    }

    // Closing: instant, reset trigger state for next open
    theaIsOpen = false;
    const win = document.getElementById('thea-window');
    const backdrop = document.getElementById('thea-backdrop');
    const isMobile = window.innerWidth <= 480;
    win.classList.remove('thea-open');
    if (backdrop) backdrop.classList.remove('thea-open');
    win.style.height = '';
    win.style.top = '';
    win.style.bottom = '';
    if (wrap) {
      wrap.classList.remove('thea-merging', 'thea-merging-out');
    }
    if (isMobile) {
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      document.body.style.overflow = '';
      window.scrollTo(0, theaScrollY);
    }
  }

  function theaOpenChat() {
    theaIsOpen = true;
    const win = document.getElementById('thea-window');
    const backdrop = document.getElementById('thea-backdrop');
    const isMobile = window.innerWidth <= 480;
    win.classList.add('thea-open');
    if (backdrop) backdrop.classList.add('thea-open');
    if (isMobile) {
      // Lock the page behind so it can't scroll
      theaScrollY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = '-' + theaScrollY + 'px';
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';
      // On mobile lock to full visible viewport immediately
      const vh = window.visualViewport ? window.visualViewport.height : window.innerHeight;
      const vt = window.visualViewport ? window.visualViewport.offsetTop : 0;
      win.style.height = vh + 'px';
      win.style.top = vt + 'px';
      win.style.bottom = 'auto';
    } else {
      win.style.height = '';
      win.style.top = '';
      win.style.bottom = '';
    }
    if (!theaStarted) { theaStarted = true; theaGreet(); }
    setTimeout(() => document.getElementById('thea-input').focus(), 400);
  }

  async function theaGreet() {
    theaShowTyping(true);
    const reply = await theaCall("Hello, I have just arrived on your website.");
    theaShowTyping(false);
    if (reply) theaAddMessage(reply, 'agent');
  }

  function theaAddMessage(text, role) {
    const msgs = document.getElementById('thea-messages');
    const wrap = document.createElement('div');
    wrap.className = 'thea-msg thea-' + role;
    const label = document.createElement('div');
    label.className = 'thea-msg-label';
    label.textContent = role === 'agent' ? 'Thea' : 'You';
    const bubble = document.createElement('div');
    bubble.className = 'thea-bubble';
    bubble.innerHTML = text.replace(/\n/g, '<br>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    wrap.appendChild(label);
    wrap.appendChild(bubble);
    msgs.appendChild(wrap);
    msgs.scrollTop = msgs.scrollHeight;
  }

  function theaShowTyping(show) {
    const t = document.getElementById('thea-typing');
    const msgs = document.getElementById('thea-messages');
    if (show) {
      t.classList.add('thea-visible');
      msgs.after(t);
    } else {
      t.classList.remove('thea-visible');
    }
    document.getElementById('thea-messages').scrollTop = 99999;
  }

  async function theaCall(userMsg) {
    theaHistory.push({ role: 'user', content: userMsg });
    try {
      const res = await fetch(THEA_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: theaHistory })
      });
      const data = await res.json();
      if (data.reply) {
        theaHistory.push({ role: 'assistant', content: data.reply });
        return data.reply;
      }
    } catch(e) {
      return "Forgive me — I seem to have lost my connection for a moment. Please try again shortly.";
    }
    return null;
  }

  async function theaSend() {
    const input = document.getElementById('thea-input');
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    input.style.height = 'auto';
    document.getElementById('thea-send').disabled = true;
    theaAddMessage(text, 'user');
    theaShowTyping(true);
    const reply = await theaCall(text);
    theaShowTyping(false);
    if (reply) theaAddMessage(reply, 'agent');
    document.getElementById('thea-send').disabled = false;
    input.focus();
  }

  function theaHandleKey(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); theaSend(); }
  }

  function theaResize(el) {
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight, 88) + 'px';
  }
</script>
<!-- END THEA WIDGET v5.0 -->

  </body>
</html>