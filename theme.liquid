    }

    #thea-messages {
      flex: 1;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      min-height: 0;
    }

    #thea-input-area {
      position: relative;
      flex-shrink: 0;
      padding-bottom: env(safe-area-inset-bottom, 12px);
    }

    #thea-input {
      font-size: 16px;
    }

    #thea-header {
      padding: 6px 18px 6px;
    }

    #thea-header-logo {
