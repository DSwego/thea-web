{%- comment -%} THEA: ingredients line under the product title. Edit text in admin: Product > Metafields > Ingredients {%- endcomment -%}
{%- assign thea_ing = product.metafields.custom.ingredients.value -%}
{%- if thea_ing != blank -%}
  <div class="thea-ingredients">
    <p class="thea-ingredients__label">Ingredients</p>
    {%- assign thea_lines = thea_ing | newline_to_br | split: '<br />' -%}
    {%- for line in thea_lines -%}
      {%- assign l = line | strip -%}
      {%- if l != blank -%}<p class="thea-ingredients__list">{{ l | escape }}</p>{%- endif -%}
    {%- endfor -%}
    <p class="thea-ingredients__note">Naturally caffeine-free &middot; May contain traces of nuts</p>
  </div>
  <style>
    .thea-ingredients{margin:0.6rem 0 1.6rem;padding:1.1rem 1.4rem;border-left:2px solid #3f5145;background:rgba(63,81,69,0.05);border-radius:0 6px 6px 0}
    .thea-ingredients p{margin:0}
    .thea-ingredients__label{font-size:1.1rem;letter-spacing:0.18em;text-transform:uppercase;color:#3f5145;margin-bottom:0.4rem!important;font-weight:600}
    .thea-ingredients__list{font-size:1.5rem;line-height:1.55;color:rgb(var(--color-foreground))}
    .thea-ingredients__list + .thea-ingredients__list{margin-top:0.9rem!important;padding-top:0.9rem;border-top:1px solid rgba(63,81,69,0.3)}
    .thea-ingredients__note{font-size:1.2rem;margin-top:0.9rem!important;padding-top:0.7rem;border-top:1px solid rgba(63,81,69,0.3);color:rgba(var(--color-foreground),0.65);letter-spacing:0.04em}
  </style>
{%- endif -%}
