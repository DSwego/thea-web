 .thea-sg-hero-fade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top;display:block;z-index:1;}
 .thea-sg-hero-content{position:absolute;left:0;right:0;top:0;padding:24px 40px 0;color:var(--thea-sg-white);z-index:2;text-align:center;}
