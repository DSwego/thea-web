    align-items:center;justify-content:center;padding:24px;}
  .thea-sg-modal-overlay.thea-sg-is-open{display:flex;}
  .thea-sg-modal-box{background:var(--thea-sg-white);max-width:440px;width:100%;padding:48px 38px;text-align:center;position:relative;font-family:'Montserrat',sans-serif;}
  .thea-sg-modal-close{position:absolute;top:18px;right:20px;background:none;border:none;cursor:pointer;
    font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--thea-sg-stone);}
  .thea-sg-modal-eyebrow{font-size:11px;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:var(--thea-sg-stone);margin:0 0 18px;}
  .thea-sg-modal-title{font-weight:500;font-size:clamp(22px,3.5vw,28px);text-transform:uppercase;letter-spacing:-.01em;color:var(--thea-sg-ink);margin:0 0 18px;line-height:1.2;}
  .thea-sg-modal-text{font-weight:400;font-size:14px;line-height:1.75;color:var(--thea-sg-ink);opacity:.78;margin:0 0 30px;}
  .thea-sg-modal-cta{display:block;font-weight:700;font-size:12px;letter-spacing:.2em;text-transform:uppercase;
    padding:16px 28px;background:var(--thea-sg-moss);color:var(--thea-sg-white);text-decoration:none;}
  .thea-sg-modal-cta:hover{background:var(--thea-sg-ink);}
  @media (max-width:760px){
    .thea-sg-doors{grid-template-columns:1fr;}
    .thea-sg-door{aspect-ratio:4/3;}
    .thea-sg-hero{height:75svh;}
    .thea-sg-teaser-content{padding:0 24px 40px;}
  }
</style>

