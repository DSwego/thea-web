  .thea-sg-gate-message.thea-sg-error{color:#a85a4a;}
  .thea-sg-leaf-divider{display:flex;align-items:center;justify-content:center;gap:18px;padding:16px 24px;position:relative;
    background:linear-gradient(180deg, #f3f2ee 0%, #d6d4cc 100%);}
  .thea-sg-leaf-divider::before,.thea-sg-leaf-divider::after{content:"";height:1px;width:64px;background:var(--thea-sg-stone);position:relative;z-index:1;}
  .thea-sg-leaf-divider img{height:22px;width:auto;opacity:.85;position:relative;z-index:1;}
