  .thea-sg-door:hover{box-shadow:inset 0 0 0 2px var(--thea-sg-sage2);}
  .thea-sg-door .thea-sg-bgimg{transition:transform .6s cubic-bezier(.2,.8,.2,1);}
  .thea-sg-door-content{position:absolute;left:0;right:0;bottom:0;padding:28px 26px 30px;color:var(--thea-sg-white);z-index:2;}
  .thea-sg-door-num{font-size:11px;font-weight:600;letter-spacing:.25em;color:rgba(255,255,255,.65);margin:0 0 8px;text-transform:uppercase;}
  .thea-sg-door-title{font-weight:500;font-size:clamp(22px,3vw,30px);text-transform:uppercase;letter-spacing:-.005em;margin:0 0 8px;color:var(--thea-sg-cream);}
