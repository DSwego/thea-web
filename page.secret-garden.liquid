<script>
(function() {
  var doorTriggers = document.querySelectorAll('.thea-sg-door-trigger');
  var doorModal = document.getElementById('thea-sg-door-modal');
  var doorClose = document.getElementById('thea-sg-door-modal-close');
  var panels = document.querySelectorAll('.thea-sg-modal-panel');

  function showPanel(key) {
    panels.forEach(function(p) {
      p.style.display = (p.getAttribute('data-panel') === key) ? '' : 'none';
    });
  }

  function openDoorModal(key) {
    showPanel(key);
    doorModal.classList.add('thea-sg-is-open');
    document.body.style.overflow = 'hidden';
  }
  function closeDoorModal() {
    doorModal.classList.remove('thea-sg-is-open');
    document.body.style.overflow = '';
  }

  doorTriggers.forEach(function(btn) {
    btn.addEventListener('click', function() {
      openDoorModal(btn.getAttribute('data-modal') || 'meditations');
    });
  });
  doorClose.addEventListener('click', closeDoorModal);
  doorModal.addEventListener('click', function(e) {
    if (e.target === doorModal) closeDoorModal();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeDoorModal();
  });

  const GARDEN_CHECK_URL = 'https://thea-web.onrender.com/garden-check';
  const STORAGE_KEY = 'thea_garden_access';

  const input = document.getElementById('thea-sg-code-input');
  const submit = document.getElementById('thea-sg-code-submit');
  const message = document.getElementById('thea-sg-gate-message');
  let checking = false;

  function checkAccess() {
    try { return localStorage.getItem(STORAGE_KEY) === 'subscriber'; }
    catch (e) { return false; }
  }

  function showMessage(text, kind) {
    message.textContent = text;
    message.className = 'thea-sg-gate-message' + (kind ? ' thea-sg-' + kind : '');
  }

  function tryUnlock(code) {
    const cleaned = (code || '').trim();
    if (!cleaned || checking) return;
    checking = true;
    showMessage('Checking your key...', '');
    fetch(GARDEN_CHECK_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code: cleaned })
    })
      .then(function(r) {
        return r.json().then(function(d) { return { status: r.status, data: d }; });
      })
      .then(function(res) {
        checking = false;
        if (res.data && res.data.ok) {
          try { localStorage.setItem(STORAGE_KEY, 'subscriber'); } catch (e) {}
          showMessage('The gate opens. Welcome in.', 'success');
          setTimeout(function() {
            window.location.href = '/pages/inner-garden';
          }, 1100);
        } else if (res.status === 429) {
          showMessage('Too many attempts. Please try again in a few minutes.', 'error');
        } else {
          showMessage('That key does not fit. Try again.', 'error');
        }
      })
      .catch(function() {
        checking = false;
        showMessage('We could not check your key just now. Please try again in a moment.', 'error');
      });
  }

  if (submit && input) {
    submit.addEventListener('click', function() { tryUnlock(input.value); });
    input.addEventListener('keydown', function(e) { if (e.key === 'Enter') tryUnlock(input.value); });
  }

  if (checkAccess() && message) {
    message.textContent = 'The garden remembers you.';
    message.className = 'thea-sg-gate-message thea-sg-success';
  }
})();
</script>

<script>
(function() {
  var lazyVideos = document.querySelectorAll('.thea-sg-lazy-video');
  var players = new WeakMap();

  function getPlayer(iframe) {
    if (!players.has(iframe)) {
      players.set(iframe, new Vimeo.Player(iframe));
    }
    return players.get(iframe);
  }

  function loadAndPlay(wrap) {
    var iframe = wrap.querySelector('iframe');
    if (!iframe) return;
    if (!iframe.getAttribute('src')) {
      iframe.setAttribute('src', iframe.getAttribute('data-src'));
    }
    getPlayer(iframe).play().catch(function() {});
  }

  function pause(wrap) {
    var iframe = wrap.querySelector('iframe');
    if (!iframe || !iframe.getAttribute('src')) return;
    getPlayer(iframe).pause().catch(function() {});
  }

  if ('IntersectionObserver' in window && window.Vimeo) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          loadAndPlay(entry.target);
        } else {
          pause(entry.target);
        }
      });
    }, { threshold: 0, rootMargin: '600px 0px 600px 0px' });
    lazyVideos.forEach(function(wrap) { observer.observe(wrap); });
  } else {
    lazyVideos.forEach(function(wrap) {
      var iframe = wrap.querySelector('iframe');
      if (iframe) iframe.setAttribute('src', iframe.getAttribute('data-src'));
    });
  }
})();
</script>
