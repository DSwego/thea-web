  .thea-sg-med-hero-text{font-size:15px;font-weight:500;line-height:1.7;color:var(--thea-sg-cream);max-width:560px;margin:0 auto;}
  @media (max-width:760px){.thea-sg-med-hero{min-height:46svh;}}
  .thea-sg-below-text{padding:26px 40px 6px;text-align:center;max-width:600px;margin:0 auto;}
