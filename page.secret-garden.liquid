 .thea-sg-hero-title{font-weight:500;font-size:clamp(40px,7.5vw,96px);line-height:.96;text-transform:uppercase;letter-spacing:-.01em;margin:0 auto;max-width:780px;color:var(--thea-sg-cream);}
