  .thea-sg-below-text-body{font-weight:500;font-size:15px;line-height:1.7;color:var(--thea-sg-ink);opacity:.82;margin:0;}
  .thea-sg-teaser{position:relative;z-index:1;width:100%;min-height:60svh;overflow:hidden;margin-top:2px;}
 .thea-sg-teaser-fade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:bottom;display:block;z-index:1;}
