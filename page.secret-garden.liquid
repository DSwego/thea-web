  .thea-sg-doors{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;background:var(--thea-sg-ink);}
  .thea-sg-door{position:relative;aspect-ratio:3/4;overflow:hidden;cursor:pointer;border:0;padding:0;display:block;width:100%;}
