  .thea-sg-door-ingredients{font-size:11px;font-weight:400;letter-spacing:.04em;color:rgba(255,255,255,.62);margin:4px 0 0;}
  .thea-sg-door-lock{position:absolute;top:22px;right:22px;z-index:3;width:34px;height:34px;background:rgba(255,255,255,.95);border-radius:50%;display:flex;align-items:center;justify-content:center;}
  .thea-sg-door-lock svg{width:14px;height:14px;stroke:var(--thea-sg-moss);stroke-width:1.6;fill:none;}
  .thea-sg-med-hero{position:relative;z-index:1;width:100%;min-height:56svh;overflow:hidden;cursor:pointer;border:0;padding:0;display:block;}
  .thea-sg-med-hero-content{position:absolute;left:0;right:0;bottom:0;padding:56px 40px 36px;color:var(--thea-sg-white);z-index:2;text-align:center;background:linear-gradient(180deg, transparent 0%, rgba(16,21,12,0.72) 55%, rgba(16,21,12,0.88) 100%);}
