          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n  #thea-sticky-cart{position:fixed;left:0;right:0;bottom:0;z-index:40;background:#ffffff;border-top:1px solid rgba(0,0,0,0.1);box-shadow:0 -4px 16px rgba(0,0,0,0.08);padding:10px 16px;display:none;align-items:center;justify-content:space-between;gap:12px;transform:translateY(100%);transition:transform .25s ease;}\n  #thea-sticky-cart.thea-visible{transform:translateY(0);}\n  #thea-sticky-cart .thea-sc-info{display:flex;flex-direction:column;min-width:0;}\n  #thea-sticky-cart .thea-sc-title{font-size:1.2rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px;}\n  #thea-sticky-cart .thea-sc-price{font-size:1.3rem;opacity:.75;}\n  #thea-sticky-cart button{flex-shrink:0;padding:12px 22px;border-radius:6px;border:none;background:#2c332f;color:#fff;font-weight:600;font-size:1.3rem;cursor:pointer;}\n  @media screen and (min-width:750px){#thea-sticky-cart{display:none !important;}}\n  @media screen and (max-width:749px){#thea-sticky-cart{display:flex;}}\n</style>\n<div id=\"thea-sticky-cart\">\n  <div class=\"thea-sc-info\">\n    <span class=\"thea-sc-title\">{{ product.title }}</span>\n    <span class=\"thea-sc-price\">{{ product.selected_or_first_available_variant.price | money }}</span>\n  </div>\n  <button type=\"button\" id=\"thea-sticky-cart-btn\">Add to Cart</button>\n</div>\n<script>\n(function(){\n  var bar = document.getElementById('thea-sticky-cart');\n  var btn = document.getElementById('thea-sticky-cart-btn');\n  if(!bar || !btn) return;\n  var infoSection = document.querySelector('.product__info-container');\n  var realBtn = function(){\n    return document.querySelector('product-form [type=\"submit\"]') || document.querySelector('form[action*=\"/cart/add\"] [type=\"submit\"]');\n  };\n  btn.addEventListener('click', function(){\n    var rb = realBtn();\n    if(rb) rb.click();\n  });\n  if(infoSection && 'IntersectionObserver' in window){\n    var observer = new IntersectionObserver(function(entries){\n      entries.forEach(function(entry){\n        if(entry.isIntersecting){\n          bar.classList.remove('thea-visible');\n        } else if(entry.boundingClientRect.top < 0){\n          bar.classList.add('thea-visible');\n        } else {\n          bar.classList.remove('thea-visible');\n        }\n      });\n    }, { threshold: 0 });\n    observer.observe(infoSection);\n  }\n})();\n</script>"
